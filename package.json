{
  "name": "study-planner-mern",
  "version": "1.0.0",
  "description": "Study Planner Full-Stack MERN Application",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "npm run dev --prefix server",
    "build:client": "npm run build --prefix client",
    "test:api": "npm run test:api --prefix server",
    "test:db": "npm run db:check --prefix server",
    "test:python": "python -m unittest discover -s tests -v",
    "test": "npm run test:api && npm run test:python"
  },
  "keywords": [
    "mern",
    "study-planner",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "Bhawana Kumawat (24ESKCS088)",
  "license": "ISC"
}
